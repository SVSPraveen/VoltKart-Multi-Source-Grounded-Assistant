# VoltKart Multi-Source Assistant Environment Configuration
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit your actual .env file or private API keys to version control.

# ==============================================================================
# 1. LLM Provider & Model Configuration
# ==============================================================================
# LLM provider to use: "gemini" (default) or "ollama" for local offline inference.
LLM_PROVIDER=gemini

# Primary reasoning and extraction model ID.
# Recommended default for Google AI Studio free tier: gemini-2.5-flash
# Alternative models: gemini-1.5-pro, gemini-1.5-flash
LLM_MODEL=gemini-2.5-flash

# Base API endpoint for Generative Language API calls.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Google AI Studio API key (Required for live LLM inference).
# Obtain a free key at: https://aistudio.google.com/
# NOTE: If omitted or set to placeholder, the assistant runs in deterministic
# offline mode using the verified response cache in data/llm_cache.json.
GEMINI_API_KEY=your_gemini_api_key_here

# Specific model override for SQL query generation and doc extraction (defaults to LLM_MODEL)
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# 2. Web Search Bonus (B8) Configuration
# ==============================================================================
# Search provider hierarchy: "tavily" or "duckduckgo" (default fallback)
SEARCH_PROVIDER=duckduckgo

# Optional Tavily API key for live web search (B8).
# If provided, high-speed verified search results are fetched via Tavily.
# If left empty, system automatically falls back to keyless DuckDuckGo search.
TAVILY_API_KEY=

# ==============================================================================
# 3. Server & Network Configuration
# ==============================================================================
# Host interface to bind uvicorn server (127.0.0.1 for local development)
HOST=127.0.0.1

# HTTP port for FastAPI backend and static React frontend
PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# 4. Storage & Persistence Paths
# ==============================================================================
# Path to persistent DuckDB database file for analytical tables
DATABASE_PATH=data/assistant.duckdb

# Directory for user-uploaded documents and CSV files
UPLOAD_DIR=data/uploads

# Path to initial bootstrap sample bundle directory
SAMPLE_BUNDLE_DIR=assignment/VoltKart_Sample_Bundle
