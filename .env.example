# VoltKart Assistant Environment Configuration
# Copy this file to .env and populate with your local values.
# NEVER commit the real .env file to version control.

# Gemini API Configuration (Required for Phase 3+ live LLM queries)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Web Search Bonus (B8) Configuration
# If provided, Tavily search is enabled. If empty or omitted, system falls back to keyless search.
TAVILY_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Storage & Paths
DATABASE_PATH=data/assistant.duckdb
UPLOAD_DIR=data/uploads
SAMPLE_BUNDLE_DIR=assignment/VoltKart_Sample_Bundle
